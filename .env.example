# Optional server-side Groq access for extraction and grounded answers.
# Without a key, posts are still saved and the app returns a safe retrieval-only
# fallback with source discussions.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Supabase was in the initial architecture brief, but this workspace build uses
# Replit-managed PostgreSQL through DATABASE_URL instead. These are not read by
# the current app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
